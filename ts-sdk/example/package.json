{
  "name": "apache-airflow-ts-sdk-example",
  "private": true,
  "version": "1.0.0-beta2",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "airflow-ts-pack src/main.ts --outdir dist",
    "typecheck": "tsc --noEmit",
    "build:hitl": "airflow-ts-pack src/hitl.ts --outfile dist/hitl.min.mjs",
    "build:ai-approval": "airflow-ts-pack src/ai-approval.ts --outfile dist/ai-approval.min.mjs",
    "build:providers": "airflow-ts-pack src/providers.ts --outfile dist/providers.min.mjs",
    "build:localfile": "airflow-ts-pack src/localfile.ts --outfile dist/localfile.min.mjs"
  },
  "dependencies": {
    "@apache-airflow/providers-amazon": "workspace:*",
    "@apache-airflow/providers-common-ai": "workspace:*",
    "@apache-airflow/providers-standard": "workspace:*",
    "@apache-airflow/providers-ts-localfile": "workspace:*",
    "@apache-airflow/ts-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.4.1",
    "typescript": "^6.0.2"
  }
}
