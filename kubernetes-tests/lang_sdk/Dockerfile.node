#
# TypeScript worker image for the "typescript" queue: the stock prod image plus
# a Node runtime so the NodeCoordinator can exec `node`. The prod image ships
# Node only in its CI variant, so the queue needs an image of its own -- the
# same shape as the Java queue's prod+JRE image (Dockerfile.java).
ARG BASE_IMAGE
ARG NODE_IMAGE=node:22-slim
FROM ${NODE_IMAGE} AS nodejs
FROM ${BASE_IMAGE}

# The interpreter is copied from the official image rather than installed with
# apt because Debian bookworm packages Node 18 and the TypeScript SDK requires
# 22. Both images are bookworm, so the binary finds the libc/libstdc++ it was
# linked against; `node --version` fails the build here if that ever stops
# holding.
COPY --from=nodejs /usr/local/bin/node /usr/local/bin/node
RUN node --version
